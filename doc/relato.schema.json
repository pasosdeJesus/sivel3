{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sivel.xyz/schemas/relato.schema.json",
  "title": "Relato de Violencia Política",
  "description": "Esquema JSON equivalente al DTD relatos-099.dtd del Banco de Datos del CINEP. Incluye tesauros completos del marco conceptual y reglas de formato del SKILL.",
  "type": "object",
  "properties": {
    "relatos": {
      "type": "array",
      "items": { "$ref": "#/$defs/relato" },
      "minItems": 1
    }
  },
  "required": ["relatos"],
  "$defs": {
    "mayusculas": {
      "type": "string",
      "pattern": "^[A-ZÁÉÍÓÚÑ][A-ZÁÉÍÓÚÑ ]*$"
    },
    "fecha_valida": {
      "type": "string",
      "pattern": "^\\d{4}-(\\d{2}|00)-(\\d{2}|00)$"
    },
    "relato": {
      "type": "object",
      "properties": {
        "organizacion_responsable": { 
          "type": "string",
          "const": "Banco de Datos del CINEP"
        },
        "derechos": { 
          "type": "string",
          "const": "Creative Commons Atribución 2.5 Colombia"
        },
        "id_relato": { 
          "type": "string",
          "readOnly": true
        },
        "forma_compartir": { 
          "type": "string",
          "enum": ["publico", "privado", "restringido"]
        },
        "titulo": { 
          "type": ["string", "null"],
          "maxLength": 50
        },
        "hechos": { 
          "type": "string"
        },
        "personas": {
          "type": "array",
          "items": { "$ref": "#/$defs/persona" }
        },
        "grupos": {
          "type": "array",
          "items": { "$ref": "#/$defs/grupo" }
        },
        "victimas": {
          "type": "array",
          "items": { "$ref": "#/$defs/victima" }
        },
        "presuntos_responsables_individuales": {
          "type": "array",
          "items": { "$ref": "#/$defs/presunto_responsable_individual" }
        },
        "fecha": { 
          "type": ["string", "null"],
          "$ref": "#/$defs/fecha_valida"
        },
        "hora": { 
          "type": ["string", "null"],
          "pattern": "^(0[0-9]|1[0-2]):[0-5][0-9] (AM|PM)$"
        },
        "duracion": { "type": ["string", "null"] },
        "ubicaciones_secundarias": {
          "type": "array",
          "items": { "$ref": "#/$defs/ubicacion_secundaria" }
        },
        "departamento": { 
          "type": ["string", "null"],
          "enum": [
            "Amazonas", "Antioquia", "Arauca", "Atlántico", "Bogotá D.C.",
            "Bolívar", "Boyacá", "Caldas", "Caquetá", "Casanare", "Cauca",
            "Cesar", "Chocó", "Córdoba", "Cundinamarca", "Guainía", "Guaviare",
            "Huila", "La Guajira", "Magdalena", "Meta", "Nariño", "Norte de Santander",
            "Putumayo", "Quindío", "Risaralda", "San Andrés y Providencia",
            "Santander", "Sucre", "Tolima", "Valle del Cauca", "Vaupés", "Vichada",
            null
          ]
        },
        "municipio": { "type": ["string", "null"] },
        "centro_poblado": { "type": ["string", "null"] },
        "longitud": { "type": ["string", "null"] },
        "latitud": { "type": ["string", "null"] },
        "actos": {
          "type": "array",
          "items": { "$ref": "#/$defs/acto" }
        },
        "contextos": {
          "type": "array",
          "items": { "$ref": "#/$defs/contexto_valor" }
        },
        "fuentes": {
          "type": "array",
          "items": { "$ref": "#/$defs/fuente" }
        },
        "acciones_juridicas": {
          "type": ["object", "null"],
          "properties": {
            "observaciones": {
              "type": "array",
              "items": { "$ref": "#/$defs/observacion" }
            }
          }
        },
        "otras_acciones": { "type": ["string", "null"] },
        "fecha_publicacion": { 
          "type": ["string", "null"],
          "readOnly": true,
          "format": "date-time"
        },
        "anexo": {
          "type": ["object", "null"],
          "properties": {
            "observaciones": {
              "type": "array",
              "items": { "$ref": "#/$defs/observacion" }
            }
          }
        },
        "combatientes": {
          "type": "array",
          "items": { "$ref": "#/$defs/combatiente" }
        },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      },
      "required": ["organizacion_responsable", "derechos", "id_relato", "forma_compartir", "hechos"]
    },
    "persona": {
      "type": "object",
      "properties": {
        "id_persona": { "type": "string" },
        "nombre": { "$ref": "#/$defs/mayusculas" },
        "nombre2": { "$ref": "#/$defs/mayusculas" },
        "apellido": { "$ref": "#/$defs/mayusculas" },
        "apellido2": { "$ref": "#/$defs/mayusculas" },
        "docid": { "type": ["string", "null"] },
        "fecha_nacimiento": { 
          "type": ["string", "null"],
          "$ref": "#/$defs/fecha_valida"
        },
        "sexo": { 
          "type": ["string", "null"],
          "enum": ["M", "F", null]
        },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      },
      "required": ["id_persona"]
    },
    "grupo": {
      "type": "object",
      "properties": {
        "id_grupo": { 
          "type": ["string", "null"],
          "enum": ["4", "5", "6", "7", "14", "25", "35", "38", "51", null]
        },
        "nombre_grupo": { "$ref": "#/$defs/mayusculas" },
        "sigla": { "type": ["string", "null"] },
        "subgrupo_de": { "type": ["string", "null"] },
        "agresion_sin_vicd": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      }
    },
    "victima": {
      "type": "object",
      "properties": {
        "id_persona": { "type": "string" },
        "ocupacion": { "$ref": "#/$defs/mayusculas" },
        "sector_condicion": { "$ref": "#/$defs/mayusculas" },
        "iglesia": { "type": ["string", "null"] },
        "organizacion": { "$ref": "#/$defs/mayusculas" },
        "id_grupo": { 
          "type": ["string", "null"],
          "enum": ["4", "5", "6", "7", "14", "25", "35", null]
        },
        "estado_tras_hecho": { "type": ["string", "null"] },
        "danio_directo": { "type": ["string", "null"] },
        "danio_indirecto": { "type": ["string", "null"] },
        "personas_dependientes": { "type": ["string", "null"] },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      },
      "required": ["id_persona"]
    },
    "presunto_responsable_individual": {
      "type": "object",
      "properties": {
        "id_persona": { "type": "string" },
        "id_grupo": { 
          "type": ["string", "null"],
          "enum": ["4", "5", "6", "7", "14", "25", "35", null]
        },
        "alias": { "type": ["string", "null"] },
        "agresion_sin_vicd": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      },
      "required": ["id_persona"]
    },
    "acto": {
      "type": "object",
      "properties": {
        "agresion": { 
          "type": "string",
          "enum": ["VIDA", "INTEGRIDAD", "LIBERTAD"]
        },
        "agresion_particular": { 
          "type": ["string", "null"],
          "enum": [
            "EJECUCIÓN EXTRAJUDICIAL (10)", "ATENTADO (16)", "AMENAZA INDIVIDUAL (15)",
            "AMENAZA COLECTIVA (18)", "TORTURA (12)", "LESIÓN FÍSICA (13)",
            "COLECTIVO LESIONADO (17)", "VIOLENCIA SEXUAL (19)", "VIOLACIÓN (191)",
            "EMBARAZO FORZADO (192)", "PROSTITUCIÓN FORZADA (193)",
            "ESTERILIZACIÓN FORZADA (194)", "ESCLAVITUD SEXUAL (195)",
            "ABUSO SEXUAL (196)", "ABORTO FORZADO (197)", "DESAPARICIÓN FORZADA (11)",
            "DETENCIÓN ARBITRARIA (14)", "JUDICIALIZACIÓN ARBITRARIA (141)",
            "DEPORTACIÓN (101)", "DESPLAZAMIENTO FORZADO COLECTIVO (102)",
            "CONFINAMIENTO (104)", "SECUESTRO POR INSURGENCIA (41)",
            "RAPTO POR MÓVILES POLÍTICOS (48)", "ATAQUE INDISCRIMINADO (90)",
            "HOMICIDIO INTENCIONAL DE PERSONA PROTEGIDA (701)",
            "MUERTE DE CIVIL EN ACCIÓN BÉLICA (703)", "TOMA DE REHENES (74)",
            "RECLUTAMIENTO DE MENORES (75)", "PILLAJE (95)", "COMBATE (62)",
            "EMBOSCADA (63)", "BOMBARDEO - AMETRALLAMIENTO (65)",
            null
          ]
        },
        "id_victima_individual": { "type": ["string", "null"] },
        "id_grupo_victima": { "type": ["string", "null"] },
        "id_presunto_grupo_responsable": { 
          "type": ["string", "null"],
          "enum": ["4", "5", "6", "7", "14", "25", "35", null]
        },
        "id_presunto_responsable_individual": { "type": ["string", "null"] }
      },
      "required": ["agresion"],
      "oneOf": [
        { "required": ["id_victima_individual"] },
        { "required": ["id_grupo_victima"] }
      ],
      "oneOf": [
        { "required": ["id_presunto_grupo_responsable"] },
        { "required": ["id_presunto_responsable_individual"] }
      ]
    },
    "contexto_valor": {
      "type": "string",
      "enum": [
        "ABUSO POLICIAL", "ACCIONES BÉLICAS", "CAMPAÑAS DE INTOLERANCIA",
        "CONFLICTO ARMADO", "CONFLICTOS ESTUDIANTILES", "CONFLICTOS LABORALES",
        "CULTIVOS DE USO ILÍCITO", "DESALOJOS", "ENCLAVES ECONÓMICOS",
        "ERRADICACIÓN FORZADA", "FALSO POSITIVO", "MANIFESTACIONES",
        "MARCHA CAMPESINA", "MEGAPROYECTOS", "MILITARIZACIÓN", "MINERO ENERGETICO",
        "OCUPACIONES", "PARAMILITARIZACIÓN", "PARO AGRARIO", "PARO ARMADO",
        "PARO CAMIONERO", "PARO CÍVICO", "PARO NACIONAL 28 DE ABRIL DE 2021",
        "PERSECUCIÓN A IGLESIA", "PERSECUCIÓN A ORGANIZACIÓN", "PRESENCIA DE MILICIAS",
        "PRESENCIA GUERRILLERA", "PROBL. ÉTNICA (NEG.E IN.)", "PROBLEMÁTICA AMBIENTAL",
        "PROBLEMÁTICA CARCELARIA", "PROBLEMÁTICA FRONTERIZA", "PROCESO JUDICIAL",
        "PROCESOS DE PAZ O DIÁLOGO", "PROCESOS ELECTORALES", "PROTESTA",
        "RESTITUCIÓN DE TIERRAS", "SEGURIDAD INFORMÁTICA", "TOMA DE TIERRAS",
        "ZONAS DE REHAB. Y CONSOL"
      ]
    },
    "fuente": {
      "type": "object",
      "properties": {
        "nombre_fuente": { "type": "string" },
        "fecha_fuente": { 
          "type": ["string", "null"],
          "format": "date"
        },
        "ubicacion_fuente": { "type": ["string", "null"] },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      },
      "required": ["nombre_fuente"]
    },
    "combatiente": {
      "type": "object",
      "properties": {
        "nombre": { "$ref": "#/$defs/mayusculas" },
        "alias": { "type": ["string", "null"] },
        "edad": { "type": ["string", "null"] },
        "sexo": { 
          "type": ["string", "null"],
          "enum": ["M", "F", null]
        },
        "ocupacion": { "$ref": "#/$defs/mayusculas" },
        "filiacion": { "type": ["string", "null"] },
        "sector_condicion": { "$ref": "#/$defs/mayusculas" },
        "organizacion": { "$ref": "#/$defs/mayusculas" },
        "organizacion_armada": { "$ref": "#/$defs/mayusculas" },
        "resultado_agresion": { "type": ["string", "null"] },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      }
    },
    "ubicacion_secundaria": {
      "type": "object",
      "properties": {
        "departamento": { 
          "type": ["string", "null"],
          "enum": [
            "Amazonas", "Antioquia", "Arauca", "Atlántico", "Bogotá D.C.",
            "Bolívar", "Boyacá", "Caldas", "Caquetá", "Casanare", "Cauca",
            "Cesar", "Chocó", "Córdoba", "Cundinamarca", "Guainía", "Guaviare",
            "Huila", "La Guajira", "Magdalena", "Meta", "Nariño", "Norte de Santander",
            "Putumayo", "Quindío", "Risaralda", "San Andrés y Providencia",
            "Santander", "Sucre", "Tolima", "Valle del Cauca", "Vaupés", "Vichada",
            null
          ]
        },
        "municipio": { "type": ["string", "null"] },
        "centro_poblado": { "type": ["string", "null"] },
        "longitud": { "type": ["string", "null"] },
        "latitud": { "type": ["string", "null"] },
        "observaciones": {
          "type": "array",
          "items": { "$ref": "#/$defs/observacion" }
        }
      }
    },
    "observacion": {
      "type": "object",
      "properties": {
        "tipo": { 
          "type": "string",
          "enum": [
            "intervalo", "region", "sitio", "lugar", "tsitio", "contexto",
            "etnia", "subdivision", "bloque", "frente", "otro", "filiacion",
            "orientacionsexual", "vinculoestado", "anotaciones", "grinformacion",
            "grconfiabilidad", "gresclarecimiento", "grimpunidad", "bienes",
            "frontera", "organizacion_armada", "rangoedad", "hijos"
          ]
        },
        "texto": { "type": "string" }
      },
      "required": ["tipo", "texto"],
      "allOf": [
        {
          "if": {
            "properties": { "tipo": { "const": "intervalo" } }
          },
          "then": {
            "properties": {
              "texto": { 
                "enum": ["MADRUGADA", "MAÑANA", "TARDE", "NOCHE", "SIN INFORMACIÓN"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "tipo": { "const": "tsitio" } }
          },
          "then": {
            "properties": {
              "texto": { "enum": ["RURAL", "URBANO"] }
            }
          }
        },
        {
          "if": {
            "properties": { "tipo": { "const": "orientacionsexual" } }
          },
          "then": {
            "properties": {
              "texto": { 
                "enum": ["S", "LGBTI", "HOMOSEXUAL", "BISEXUAL", "TRANSGENERO", "LESBIANA", "GAY", "SIN INFORMACIÓN"]
              }
            }
          }
        }
      ]
    }
  }
}
