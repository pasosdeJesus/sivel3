# ====================================================================
#      UNIFIED ENVIRONMENT CONFIGURATION FOR SIVEL3
# ====================================================================
# This file serves as the single source of truth for both the
# Hardhat (backend) and Next.js (frontend) applications.
#
# Standard: .env.example
# ====================================================================

# --------------------------------------------------------------------
# BLOCKCHAIN & DEPLOYMENT CONFIGURATION (Used by Hardhat)
# --------------------------------------------------------------------

# sivel.xyz backend wallet (MINTER_ROLE on PasosDeJesusCredentials, deployer of other contracts).
# IMPORTANT: Use a dedicated development wallet, not one with real funds.
PRIVATE_KEY="0xa...80"

# PasosDeJesusCredentials admin wallet (DEFAULT_ADMIN_ROLE). Generated via:
#   cd apps/hardhat && node scripts/generate-wallet.mjs
CREDENTIALS_PRIVATE_KEY=""

# API key for verifying contracts on Celo's Blockscout explorer.
BLOCKSCOUT_API_KEY=""

# API key for verifying contracts on Base's explorer.
BASESCAN_API_KEY=""


# --------------------------------------------------------------------
# NEXT.JS & FRONTEND CONFIGURATION
# --------------------------------------------------------------------

# -- General App Info --
NEXT_PUBLIC_APPNAME='SIVEL 3'
NEXT_PUBLIC_WC_PROJECT_ID='9...2'
NEXT_PUBLIC_API1=https://sivel.xyz:3500/sivelxyz-admin

# -- Authentication --
NEXT_PUBLIC_AUTH_URL=https://sivel.xyz:9001
# Generate with `openssl rand -hex 32`
NEXTAUTH_SECRET=

# -- Development Options --
# For enabling experimental HTTPS features
OPDEV=""

NEXT_PUBLIC_M_DEBUGGER_CONSOLE=1

# --------------------------------------------------------------------
#      SHARED CONFIGURATION (Used by BOTH Hardhat & Next.js)
# --------------------------------------------------------------------

# -- Network Configuration --
# Celo: celo (mainnet), celoSepolia (testnet)
NEXT_PUBLIC_NETWORK=celoSepolia
NEXT_PUBLIC_RPC_URL="https://lb.drpc.org/celo-sepolia/x"
# Base: base (mainnet), baseSepolia (testnet)
NEXT_PUBLIC_BASE_NETWORK=baseSepolia
NEXT_PUBLIC_BASE_RPC_URL="https://sepolia.base.org"

# -- Contract Addresses & Details --
# The following addresses are automatically updated by deployment scripts.
NEXT_PUBLIC_REGIONALDONATION_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDT_DECIMALS=6

# SLEARN token (cashback rewards for verified donors)
NEXT_PUBLIC_SLEARN_ADDRESS=

# -- Explorer URL --
NEXT_PUBLIC_EXPLORER_TX=https://celo-sepolia.blockscout.com/tx/


# --------------------------------------------------------------------
#      DATABASE CONFIGURATION (Used by Next.js)
# --------------------------------------------------------------------
PGHOST=/var/www/var/run/postgresql/
PGDATABASE=sivel3
PGUSER=sivel3
PGPASSWORD=sivel3
PG_SUPERUSER=postgres

PORT=3029

# --------------------------------------------------------------------
#      AGENT SYNC CONFIGURATION (#44)
# --------------------------------------------------------------------
# Wallet address authorized to POST pre-alerts from sivel3agent.
# Must match AGENT_WALLET_ADDRESS in sivel3agent's apps/.env.
AGENT_WALLET_ADDRESS=0x8C88169977c180f6380C01daAA9c7F31894c20dc

# LEARN.TG

LEARNTG_ADDRESS="0x9F....9"

# --------------------------------------------------------------------
#      DOCUMENTER CONFIGURATION (REQ/44, REQ/52)
# --------------------------------------------------------------------
# Comma-separated wallet addresses with documenter privileges.
# Used by /api/pre-alerts/queue and /api/pre-alerts/:id/score.
# TODO(REQ/52): Replace with on-chain DOCUMENTER_ROLE SBT verification.
DOCUMENTER_WALLETS=
