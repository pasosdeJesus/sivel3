#!/bin/sh

. ../.env

network=$1
if (test "$network" = "") then {
  echo "Missing network baseSepolia/celoSepolia as first parameter"
  exit 1;
} fi;

#if (test "$network" = "baseSepolia") then {
#  network="base-sepolia" # Lo estandar para hardhat 2
#} fi;
dir="0x"
arch="deployments/$network.json"
#if (test "$network" = "base-sepolia") then {
#  arch="deployments/baseSepolia.json"
#} fi;
address=`grep address $arch | sed -e "s/^.*address.:..//g;s/.,$//g"`
node_modules/.bin/hardhat verify --network $network $address "https://sivel.xyz/api/credential"
