{
  "name": "@sivel3/contracts",
  "license": "MIT",
  "version": "1.0.0",
  "devDependencies": {
    "@pasosdejesus/contract-test": "catalog:",
    "@pasosdejesus/edr": "catalog:",
    "@pasosdejesus/usdt": "catalog:",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "solc": "0.8.24",
    "typechain": "^8.3.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "catalog:",
    "tsx": "^4.23.12",
    "viem": "catalog:"
  },
  "scripts": {
    "postinstall": "chmod +x sync-abis.mjs",
    "compile": "node scripts/sync-usdt.mjs && ../web/bin/m contract:compile && node sync-abis.mjs",
    "typechain": "../web/bin/m contract:typechain --target ethers-v6 --out-dir typechain-types",
    "tsc": "node_modules/.bin/tsc -p . && mkdir -p dist/typechain-types/ && cp typechain-types/*.d.ts dist/typechain-types/",
    "build": "pnpm compile && pnpm tsc",
    "clean": "../web/bin/m contract:clean",
    "run:node": "../web/bin/m contract:node",
    "test": "../web/bin/m contract:test",
    "deploy-mock-usdt": "bin/deployMockUSDT",
    "verify-mock-usdt": "bin/verifyMockUSDT",
    "deploy-regional-donation": "bin/deployRegionalDonation",
    "deploy-credentials": "bin/deployPdJCredentials",
    "deploy-prealert-market": "bin/deployPreAlertMarket",
    "deploy-reward-escrow": "bin/deployRewardEscrow",
    "verify-credentials": "bin/verifyPdJCredentials",
    "verify-prealert-market": "bin/verifyPreAlertMarket",
    "verify-reward-escrow": "bin/verifyRewardEscrow",
    "verify-regional-donation": "bin/RegionalDonationSourceVerification",
    "check-transfer": "bin/check-transfer",
    "prettier": "prettier --write 'contracts/**/*.sol' '**/*.ts'",
    "sync:abis": "node sync-abis.mjs"
  },
  "author": "pasosdeJesus"
}
