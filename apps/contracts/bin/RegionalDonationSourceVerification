#!/bin/sh
set -a
. ../.env
set +a

NETWORK=${NEXT_PUBLIC_NETWORK:-celoSepolia}
USDT=$(cd ../web && NEXT_PUBLIC_NETWORK="$NETWORK" node --input-type=module -e "import('@pasosdejesus/mpdj/blockchain/ecosystem-addresses').then(m=>console.log(m.USDT_ADDRESSES[m.resolveNetwork()]))")
if [ -f "deployments/SIVeL3RegionalDonationV2/${NETWORK}.json" ]; then
  exec ../web/bin/m contract:verify --contract SIVeL3RegionalDonationV2 --network "$NETWORK" \
    --args "[\"$USDT\",\"$NEXT_PUBLIC_ADDRESS\"]"
else
  ADDR=$(node -e "console.log(require('./deployments/SIVeL3RegionalDonationV2/V1/${NETWORK}.json').address)")
  exec ../web/bin/m contract:verify --contract SIVeL3RegionalDonationV2 --network "$NETWORK" \
    --address "$ADDR" --args "[\"$USDT\",\"$NEXT_PUBLIC_ADDRESS\"]"
fi
